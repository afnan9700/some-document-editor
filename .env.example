# ---------------------------------------------------------------
# Onyx — environment template
# Copy to `.env` and fill in the values before `docker compose up`.
#   cp .env.example .env
# Values here are safe dev defaults, not for production.
# ---------------------------------------------------------------

# --- Database -------------------------------------------------
DB_USER=postgres
DB_PASSWORD=supersecret
DB_NAME=doc-editor

# --- JWT keys (RSA) -------------------------------------------
# Backend signs/verifies access + refresh tokens with these.
# Generate a pair with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# then paste the (properly escaped) PEM contents below.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Token shared with the collaboration state worker (see below).
INTERNAL_WORKER_TOKEN=supersecret

# --- Shared infra (redis) -------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# --- Go websocket service (ws-service) ------------------------
WS_READ_LIMIT_BYTES=65536
WS_READ_TIMEOUT=60s
WS_WRITE_TIMEOUT=10s
WS_PONG_WAIT=60s
WS_PING_PERIOD=45s
WS_WRITE_WAIT=10s

# --- Spring (backend) -----------------------------------------
SPRING_PROFILES_ACTIVE=dev

# --- Node worker (collaboration-state-worker) -----------------
# SPRINGBOOT_BEARER_TOKEN  -> token the worker sends to springboot
# WORKER_BEARER_TOKEN      -> token springboot requires from the worker
# Pick distinct values for each.
SPRINGBOOT_BEARER_TOKEN=super-secret
WORKER_BEARER_TOKEN=super-duper-secret
PERSIST_INTERVAL_MS=30000
DOC_TEXT_FIELD_NAME=markdown